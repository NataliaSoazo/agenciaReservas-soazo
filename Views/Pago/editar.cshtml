@model agenciaReservas_soazo.Models.Pago
@{
ViewData["Title"] = "Editar Pago";

var reserva = ViewBag.Reserva as agenciaReservas_soazo.Models.Reserva;
var totalAPagar = ViewBag.TotalAPagar;
var conceptos = ViewBag.Concepto as List<string>;
var señaCalculada = ViewBag.PrecioPorcentaje;
}
<div class="container">
        <main role="main" class="pb-3">
            @if(ViewBag.Mensaje != null)
    {
        <div class="alert alert-success col-4">
            @ViewBag.Mensaje
        </div>
    }

    @if(TempData["Error"] != null)
    {
        <div class="alert alert-danger col-4">
            @TempData["Error"]
        </div>
    }
</div>
<div class="container mt-4">
<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Editar pago </h4>
            </div>

            <div class="card-body">

                @if (reserva != null)
                {
                    <div class="alert alert-info">
                        <h5>Datos de la Reserva</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <strong>ID Reserva:</strong>
                                @reserva.Id
                            </div>

                            <div class="col-md-6">
                                <strong>Inmueble:</strong>
                                @reserva.IdInmueble  (@reserva.DatoInmueble.Direccion)
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6">
                                <strong>Fecha Desde:</strong>
                                @reserva.FechaDesde.ToString("dd/MM/yyyy")
                            </div>

                            <div class="col-md-6">
                                <strong>Fecha Hasta:</strong>
                                @reserva.FechaHasta.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6">
                                <strong>Precio por día:</strong>
                                @reserva.DatoInmueble?.Precio
                            </div>
                            <div class="col-md-6">
                                <strong>Porcentaje requerido:</strong>
                                @reserva.DatoInmueble?.Porcentual %
                            </div>
                            <div class="col-md-6">
                                <strong>Seña Calculada:</strong>
                                <span class="fw-bold text-success">
                                   $ @señaCalculada
                                </span>
                            </div>
                            <div class="col-md-6">
                                <strong>Total a pagar:</strong>
                                <span class="fw-bold text-success">
                                  $  @totalAPagar
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Guardar" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="IdReserva"
                           value="@reserva?.Id" />

                    <input type="hidden"
                           asp-for="Anulado"
                           value="false" />

                    <div class="mb-3">
                        <label asp-for="Fecha" class="form-label"></label>

                        <input asp-for="Fecha"
                               class="form-control" disabled
                               type="date"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="Fecha"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Modo" class="form-label"  ></label>

                        <select asp-for="Modo" class="form-select" disabled>
                            <option value="">-- Seleccione un modo de pago --</option>
                            <option value="EFECTIVO">EFECTIVO</option>
                            <option value="TRANSFERENCIA">TRANSFERENCIA</option>
                            <option value="TARJETA">TARJETA</option>
                        </select>

                        <span asp-validation-for="Modo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Concepto" class="form-label"></label>

                        <select asp-for="Concepto" class="form-select">

                            <option value="">
                                -- Seleccione un concepto --
                            </option>

                            @if (conceptos != null)
                            {
                                foreach (var concepto in conceptos)
                                {
                                    <option value="@concepto">
                                        @concepto
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="Concepto"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Importe" class="form-label"></label>

                        <input asp-for="Importe"
                               class="form-control"
                               type="number" disabled
                               min="1"
                               step="0.01"
                               value="@totalAPagar" />

                        <span asp-validation-for="Importe"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-cash"></i>
                            Registrar Pago
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

</div>
<!-- Listado de pagos -->
    <div class="card p-3 shadow-sm">
        <h5 class="text-center">Listado de pagos de la reserva</h5>

        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Anulado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in
                    (IList<agenciaReservas_soazo.Models.Pago>)ViewBag.Pagos)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>@item.Concepto</td>
                        <td>@item.Importe</td>
                        <td>@(item.Anulado ? "SÍ" : "NO")</td>
                        <td>
                            <a asp-action="Detalles"
                               asp-route-id="@item.Id"
                               title="Ver detalle">
                                <i class="fa fa-eye"></i>
                            </a>

                            <a asp-action="Editar"
                               asp-route-id="@item.Id"
                               title="Editar">
                                <i class="fa fa-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@section Scripts {
@{
await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
}

