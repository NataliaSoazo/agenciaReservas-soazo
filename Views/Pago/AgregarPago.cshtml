@model agenciaReservas_soazo.Models.Pago

@{
ViewData["Title"] = "Agregar Pago";

var reserva = ViewBag.Reserva as agenciaReservas_soazo.Models.Reserva;
var totalAPagar = ViewBag.TotalAPagar;
var conceptos = ViewBag.Concepto as List<string>;
var señaCalculada = ViewBag.PrecioPorcentaje;

var pagos = ViewBag.Pagos as List<agenciaReservas_soazo.Models.Pago>
                ?? new List<agenciaReservas_soazo.Models.Pago>();
}
<div class="card shadow mt-4">
    <div class="card-header bg-secondary text-white">
        <h5 class="mb-0">Historial de pagos de la reserva</h5>
    </div>

    <div class="card-body">

        @if (pagos.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fecha</th>
                            <th>Concepto</th>
                            <th>Modo de pago</th>
                            <th>Importe</th>
                            <th>Anulado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in pagos)
                        {
                            <tr>
                                <td>
                                    @item.Fecha.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @item.Concepto
                                </td>

                                <td>
                                    @item.Modo
                                </td>

                                <td class="text-end">
                                    $ @item.Importe
                                </td>

                                <td>
                                    @if (item.Anulado)
                                    {
                                        <span class="badge bg-danger">
                                            Sí
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            No
                                        </span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Detalles" asp-route-id=@item.Id title="Ver Detalle"><i class="fa fa-eye " style="font-size:25px;"
                                            id="detalles"></i></a>
                                    <a href="#" onclick="editarPago('@item.Id','@item.Concepto')" title="Editar el concepto de pago"><i class="fa fa-pencil " style="font-size:25px;"
                                        id="edi"></i></a>
                                    @if (User.HasClaim("Rol", "ADMINISTRADOR"))
                                        {
                                            <a href="#" onclick="eliminar('@item.Id')" title="Anular">
                                                <i class="fa fa-trash" style="font-size:25px;" id="eli"></i>
                                            </a>
                                        }
                                </td>
                            </tr>
                        }
                    </tbody>

                    <tfoot>
                        <tr class="table-light">
                            <th colspan="3">Total de pagos registrados</th>
                            <th class="text-end">
                                $ @(pagos.Where(p => !p.Anulado).Sum(p => p.Importe))
                            </th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mb-0">
                Esta reserva todavía no tiene pagos registrados.
            </div>
        }

    </div>
</div>
<div class="container mt-4">
<div class="row justify-content-center">
    <div class="col-md-8">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Agregar Pago a la Reserva</h4>
            </div>

            <div class="card-body">

                @if (reserva != null)
                {
                    <div class="alert alert-info">
                        <h5>Datos de la Reserva</h5>

                        <div class="row">
                            <div class="col-md-6">
                                <strong>ID Reserva:</strong>
                                @reserva.Id
                            </div>

                            <div class="col-md-6">
                                <strong>Inmueble:</strong>
                                @reserva.IdInmueble  (@reserva.DatoInmueble.Direccion)
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6">
                                <strong>Fecha Desde:</strong>
                                @reserva.FechaDesde.ToString("dd/MM/yyyy")
                            </div>

                            <div class="col-md-6">
                                <strong>Fecha Hasta:</strong>
                                @reserva.FechaHasta.ToString("dd/MM/yyyy")
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-md-6">
                                <strong>Precio por día:</strong>
                                @reserva.DatoInmueble?.Precio
                            </div>
                            <div class="col-md-6">
                                <strong>Porcentaje requerido:</strong>
                                @reserva.DatoInmueble?.Porcentual %
                            </div>
                            <div class="col-md-6">
                                <strong>Seña Calculada:</strong>
                                <span class="fw-bold text-success">
                                   $ @señaCalculada
                                </span>
                            </div>
                            <div class="col-md-6">
                                <strong>Total a pagar:</strong>
                                <span class="fw-bold text-success">
                                  $  @totalAPagar
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <form asp-action="Guardar" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <input type="hidden"
                           asp-for="IdReserva"
                           value="@reserva?.Id" />

                    <input type="hidden"
                           asp-for="Anulado"
                           value="false" />

                    <div class="mb-3">
                        <label asp-for="Fecha" class="form-label"></label>

                        <input asp-for="Fecha"
                               class="form-control"
                               type="date"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="Fecha"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Modo" class="form-label"></label>

                        <select asp-for="Modo" class="form-select">
                            <option value="">-- Seleccione un modo de pago --</option>
                            <option value="EFECTIVO">EFECTIVO</option>
                            <option value="TRANSFERENCIA">TRANSFERENCIA</option>
                            <option value="TARJETA">TARJETA</option>
                        </select>

                        <span asp-validation-for="Modo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Concepto" class="form-label"></label>

                        <select asp-for="Concepto" class="form-select">

                            <option value="">
                                -- Seleccione un concepto --
                            </option>

                            @if (conceptos != null)
                            {
                                foreach (var concepto in conceptos)
                                {
                                    <option value="@concepto">
                                        @concepto
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="Concepto"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Importe" class="form-label"></label>

                        <input asp-for="Importe"
                               class="form-control"
                               type="number"
                               min="1"
                               step="0.01"
                               value="@totalAPagar" />

                        <span asp-validation-for="Importe"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>

                        <button type="submit"
                                class="btn btn-success">
                            <i class="bi bi-cash"></i>
                            Registrar Pago
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

</div>
<div class="table-wrapper">

    <form method="post" asp-action="EditarPago">
        @Html.AntiForgeryToken()

        <div class="modal fade"
             id="modal_editar_pago"
             tabindex="-1"
             aria-labelledby="tituloEditarPago"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloEditarPago">
                            Editar modo de pago
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               id="Pago_editar_id" />

                        <div class="mb-3">
                            <label for="Pago_editar_concepto"
                                   class="form-label">
                                Concepto de pago
                            </label>

                            <select name="Concepto"
                                    id="Pago_editar_concepto"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione el concepto a cambiar --
                                </option>

                                <option value="RESERVA INICIAL">RESERVA INICIAL</option>
                                <option value="PAGO TOTAL">PAGO TOTAL</option>
                            </select>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="submit" class="btn btn-success">
                            Guardar cambios
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </form>

</div>

<div class="modal fade"
     id="modal_eliminar_Pago"
     tabindex="-1"
     aria-labelledby="tituloEliminarPago"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Eliminar" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloEliminarPago">
                        Confirmar anulación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden"
                           name="id"
                           id="Pago_eliminar_id" />

                    <p>
                        ¿Estás seguro de que deseas anular el pago
                        <strong id="Pago_eliminar_texto"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        Confirmar anulación
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
@section Scripts {
<script>
        function editarPago(id, concepto) {
            document.getElementById("Pago_editar_id").value = id;
            document.getElementById("Pago_editar_concepto").value = concepto;
            const modalElemento = document.getElementById("modal_editar_pago");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElemento);
            modal.show();
    }
</script>
<script>
        function eliminar(id) {

            document.getElementById("Pago_eliminar_id").value = id;
            document.getElementById("Pago_eliminar_texto").innerText = id;
            const modalElemento = document.getElementById("modal_eliminar_Pago");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElemento);
            modal.show();
}
</script>
}