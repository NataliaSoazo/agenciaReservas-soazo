@model IEnumerable<Pago>
@{
    ViewData["Title"] = "Index";
}

<h4> Listado de pagos</h4>

<h5>Los nuevos pagos se cargan desde su respectiva reserva</h5>
<form asp-action="Index">
    <p>
        Buscar: <input type="text" name="buscar" class="form-text" />
        <input type="submit" value="buscar" class="btn btn-secondary">
    </p>
</form>
<div class="col-10 container table-wrapper">
<table class="table" id="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Fecha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Concepto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Importe)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Anulado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdReserva)
            </th>
            <th>
                ACCIONES
            </th>

        </tr>
    </thead>
    <tbody id="table">
        @foreach (var item in Model)
        {
            <tr>
                <th>
                    @Html.DisplayFor(model => item.Fecha)
                </th>
                <th>
                    @Html.DisplayFor(model => item.Concepto)
                </th>
                <th>
                    @Html.DisplayFor(model => item.Importe)
                </th>
                <th>
                    @(item.Anulado ? "SÍ" : "NO")
                </th>
                <th>
                    @Html.DisplayFor(model => item.IdReserva)
                </th>
                <td>
                    <a asp-controller="Pago" asp-action="agregarpago" asp-route-id="@item.IdReserva" title="Agregar pago a la reserva con código @item.IdReserva "><i class="fa fa-plus" style="font-size:25px;" id="agregar"></i></a>
                    <a asp-action="Detalles" asp-route-id=@item.Id title="Ver Detalle"><i class="fa fa-eye " style="font-size:25px;"
                            id="detalles"></i></a>
                    <a href="#" onclick="editarPago('@item.Id','@item.Concepto')" title="Editar el concepto de pago"><i class="fa fa-pencil " style="font-size:25px;"
                            id="edi"></i></a>
                    @if (ViewBag.UserRole == "ADMINISTRADOR")
                        {
                        <a href="#" onclick="eliminar('@item.Id')" title="Anular">
                            <i class="fa fa-trash" style="font-size:25px;" id="eli"></i>
                        </a>
                        }
                </td>
            </tr>
        }
    </tbody>
</table>
<nav aria-label="Paginación">

    <ul class="pagination">

        @if (ViewBag.PaginaActual > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    Anterior
                </a>
            </li>
        }

        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@i">
                    @i
                </a>

            </li>
        }

        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>
        }

    </ul>

</nav>
        <div class= "container  col-2">
            <button type="button" class="btn btn-secondary"
        onclick="history.back()">
             <i class="bi bi-arrow-left"></i> Volver
        </button>
        </div>
<div class="modal fade"
     id="modal_eliminar_Pago"
     tabindex="-1"
     aria-labelledby="tituloAnularPago"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Eliminar" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="tituloAnularPago">
                        Confirmar anulación
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="Id" id="Pago_eliminar_id" />

                    <p>
                        ¿Estás seguro de que deseas anular el pago
                        <strong id="Pago_eliminar_texto"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        Confirmar anulación
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
<div class="table-wrapper">

    <form method="post" asp-action="EditarPago">
        @Html.AntiForgeryToken()

        <div class="modal fade"
             id="modal_editar_pago"
             tabindex="-1"
             aria-labelledby="tituloEditarPago"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="tituloEditarPago">
                            Editar modo de pago
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>
                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               id="Pago_editar_id" />

                        <div class="mb-3">
                            <label for="Pago_editar_concepto"
                                   class="form-label">
                                Concepto de pago
                            </label>

                            <select name="Concepto"
                                    id="Pago_editar_concepto"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione el concepto a cambiar --
                                </option>

                                <option value="RESERVA INICIAL">RESERVA INICIAL</option>
                                <option value="PAGO TOTAL">PAGO TOTAL</option>
                            </select>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="submit" class="btn btn-success">
                            Guardar cambios
                        </button>

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Cancelar
                        </button>

                    </div>

                </div>
            </div>
        </div>
    </form>

</div>
@section Scripts {
    <script>
        function eliminar(id) {
            document.querySelector("#Pago_eliminar_id").value = id;
            document.querySelector("#Pago_eliminar_id").innerHTML = id;
            $("#modal_eliminar_Pago").modal("show");
        }
    </script>
    <script>
        function editarPago(id, concepto) {
            document.getElementById("Pago_editar_id").value = id;
            document.getElementById("Pago_editar_concepto").value = concepto;
            const modalElemento = document.getElementById("modal_editar_pago");
            const modal = bootstrap.Modal.getOrCreateInstance(modalElemento);
            modal.show();
    }
</script>
}