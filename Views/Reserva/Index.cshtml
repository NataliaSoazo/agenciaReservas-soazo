@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Index";
}


<div class="row">
    <div class="col-4">
        <p>Buscar Reservas  vigentes  entre  fechas</p>
        <form asp-action="VerVigentes" method="get">
            <div class="form-group">
                <label for="fechaDesde">Desde:</label>
                <input type="date" name="fechaDesde" class="form-control" required />
            </div>
            <div class="form-group">
                <label for="fechaHasta">Hasta:</label>
                <input type="date" name="fechaHasta" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Buscar en este rango</button>
        </form>
    </div>
        <div class="col-4">
            <form asp-action="TerminanEnXdias" method="get">
                        <p>
                            Reservas que terminen  en ... dias:
                            <div>
                                <input type="Date" name="fecha" class="form-text" required />
                                <input type="submit" value="Buscar " class="btn btn-secondary" />
                            </div>
                        </p>
                </form>
        </div>
</div>
<p>
    <a asp-action="Editar"method = "post">CREAR NUEVO </a>
</p>
<h4> Lista de reservas</h4>
<div class = "table-wrapper">
<table class="table" id="table">
      <thead>>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaDesde)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaHasta)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DatoInmueble.Direccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Arrendatario)
            </th>
            <th>
                ACCIONES
            </th>
           
        </tr>
    </thead>
    <tbody id="table">
        @foreach (var item in Model)
        {
            <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaDesde)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.FechaHasta)
            </td>
            <td>
                @(item.DatoInmueble.Direccion)
            </td>
            <td>
                @(item.Arrendatario.Nombre + " " + item.Arrendatario.Apellido)
            </td>
            <td>
                <a asp-action="Detalles" asp-route-id=@item.Id title="Ver Detalles"><i class="fa fa-eye " style="font-size:25px;" id="detalles"></i></a>
                <a asp-action="Editar" asp-route-id=@item.Id title="Editar item"><i class="fa fa-pencil " style="font-size:25px;" id="edi"></i></a>
                
                <a href="#" onclick="eliminar('@item.Id')" title="Eliminar">
                    <i class="fa fa-trash" style="font-size:25px;" id="eli"></i>
                </a>
            
                <a asp-controller="Pago" asp-action="agregarpago" asp-route-id="@item.Id" title="Agregar pago"><i class="fa fa-plus" style="font-size:25px;" id="agregar"></i></a>
                <a asp-controller="Pago" asp-action="agregarPago" asp-route-id="@item.Id" title="Listar Pagos"><i class="fa fa-bars" style="font-size:25px;" id="pagosC"></i></a>
                <a asp-action="Renovar" asp-route-id=@item.Id title="Renovar contrato"><i class="fa fa-rotate-right" style="font-size:25px;" id="ren"></i></a>
                <a href="#" onclick="solicitarBaja('@item.Id')" title="Solicitud de cancelación ">
                    <i class="fa fa-close" style="font-size:25px;" id="eli"></i>
                </a>
            </td>
            </tr>
        }
    </tbody>
</table>
</div>

<nav aria-label="Paginación">

    <ul class="pagination">

        @if (ViewBag.PaginaActual > 1)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                    Anterior
                </a>
            </li>
        }

        @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
        {
            <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@i">
                    @i
                </a>

            </li>
        }

        @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
        {
            <li class="page-item">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                    Siguiente
                </a>
            </li>
        }

    </ul>

</nav>
    <div class= "container  col-2">
            <button type="button" class="btn btn-secondary"
        onclick="history.back()">
             <i class="bi bi-arrow-left"></i> Volver
        </button>
    </div>
<form method="post" asp-action="Eliminar" id="form_eliminar_reserva">

    <div class="modal fade"
         id="modal_eliminar_Reserva"
         tabindex="-1"
         aria-labelledby="tituloEliminarReserva"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="tituloEliminarReserva">
                        ¿Deseas eliminar la reserva?
                    </h5>

                    <!-- X -->
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">

                    <input type="hidden"
                           name="id"
                           id="Reserva_eliminar_id" />

                    <p>
                        Reserva:
                        <strong id="Reserva_eliminar_nombre"></strong>
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="submit"
                            class="btn btn-danger">
                        Eliminar
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Salir
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

    
<form method="post" asp-action="SolicitarCancelacion" id="form_cancelar_reserva">

    <div class="modal fade"
         id="modal_cancelar_Reserva"
         tabindex="-1"
         aria-labelledby="tituloCancelarReserva"
         aria-hidden="true">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title" id="tituloCancelarReserva">
                        Solicitud de cancelación de reserva
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <div class="modal-body">
                
                    <input type="hidden"
                           name="id"
                           id="Reserva_cancelar_id" />

                    <spam >
                        Fecha de culminación:
                    </spam>

                    <input type="date"
                           name="fechaCulminacion"
                           id="fechaCulminacion"
                           class="form-control"
                           required />

                    <p class="mt-3">
                        Reserva:
                        <strong id="Reserva_cancelar_nombre"></strong>
                    </p>

                </div>

                <div class="modal-footer">

                    <button type="submit" class="btn btn-danger">
                        Enviar Solicitud
                    </button>

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Salir
                    </button>

                </div>

            </div>

        </div>

    </div>

</form>

@section Scripts{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function eliminar(id) {
    document.querySelector("#Reserva_eliminar_id").value = id;
    document.querySelector("#Reserva_eliminar_nombre").innerHTML = id;
    $("#modal_eliminar_Reserva").modal("show");
}
    </script>
        <script>
        function solicitarBaja(id) {
        document.getElementById("Reserva_cancelar_id").value = id;
        const modalElemento = document.getElementById("modal_cancelar_Reserva");    
        $("#modal_cancelar_Reserva ").modal("show");
        }
    </script>
}