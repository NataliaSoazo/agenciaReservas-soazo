@model agenciaReservas_soazo.Models.Reserva

@{
    ViewData["Title"] = "Reserva";
    int id = Model?.Id ?? 0;
    var inmueblesJson = ViewBag.InmueblesJson;
    var contratosJson = ViewBag.ContratosJson;
}

<div class="container text-center">
    <h4>Reserva</h4>
</div>

<hr />

<div class="row">
    <div class="col-9 table-wrapper">

        <form asp-action="Guardar" method="post" class="row g-3">

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Anulado" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group col-2">
                <label class="control-label">CÓDIGO</label>
                <input class="form-control" value="@id" readonly />
            </div>

            <div class="form-group col-5">
                <label asp-for="Fecha" class="control-label"></label>
                <input asp-for="Fecha" type="date" class="form-control" />
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="form-group col-5">
                <label asp-for="FechaDesde" class="control-label"></label>
                <input asp-for="FechaDesde" type="date" class="form-control" />
                <span asp-validation-for="FechaDesde" class="text-danger"></span>
            </div>

            <div class="form-group col-5">
                <label asp-for="FechaHasta" class="control-label"></label>
                <input asp-for="FechaHasta" type="date" class="form-control" />
                <span asp-validation-for="FechaHasta" class="text-danger"></span>
            </div>

            <div class="form-group col-7">
                <label asp-for="Monto" class="control-label"></label>
                <input asp-for="Monto" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>

            <div class="form-group col-6">
                <label asp-for="IdInquilino" class="control-label"></label>

                <select asp-for="IdInquilino" class="form-control" id="selectInquilinos">
                    <option value="">Seleccione un inquilino</option>
                    @foreach (var item in (IList<Inquilino>)ViewBag.Inquilinos)
                    {
                        <option value="@item.Id">
                            @item.Apellido @item.Nombre
                        </option>
                    }
                </select>
            </div>

            <div class="form-group col-6">
                <label asp-for="IdInmueble" class="control-label"></label>

                <select asp-for="IdInmueble" class="form-control" id="selectInmuebles">
                    <option value="">Seleccione un inmueble</option>
                    @foreach (var item in (IList<Inmueble>)ViewBag.Inmuebles)
                    {
                        <option value="@item.Id">
                            @item.Direccion
                        </option>
                    }
                </select>
            </div>

            <div class="form-group col-12">
                <input type="submit" value="Guardar" class="btn btn-success" />

                <a asp-action="Index" class="btn btn-secondary">
                    Cancelar
                </a>
            </div>

        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/select2/select2.min.js"></script>

<script>
    // 1. Convertir el JSON proveniente de C# a un objeto JavaScript
    var listaInmuebles = @Html.Raw(inmueblesJson ?? "[]");

    $(document).ready(function () {
        $('#selectInquilinos').select2({
            placeholder: 'Buscar inquilino aquí',
            allowClear: true,
            width: '100%'
        });

        $('#selectInmuebles').select2({
            placeholder: 'Buscar inmueble aquí',
            allowClear: true,
            width: '100%'
        });

        // 2. Escuchar cambios en Inmueble y en las Fechas
        $('#selectInmuebles, #FechaDesde, #FechaHasta').on('change', function () {
            calcularMontoReserva();
        });
    });

    function calcularMontoReserva() {
        var inmuebleId = $('#selectInmuebles').val();
        var fechaDesdeVal = $('#FechaDesde').val();
        var fechaHastaVal = $('#FechaHasta').val();

        // Verificar que tengamos inmueble y ambas fechas elegidas
        if (inmuebleId && fechaDesdeVal && fechaHastaVal) {
            var fDesde = new Date(fechaDesdeVal);
            var fHasta = new Date(fechaHastaVal);

            if (fHasta > fDesde) {
                // Calcular días de diferencia
                var diferenciaTiempo = fHasta.getTime() - fDesde.getTime();
                var dias = diferenciaTiempo / (1000 * 3600 * 24);

                // Buscar el inmueble seleccionado en el array JSON
                var inmueble = listaInmuebles.find(i => i.Id == inmuebleId);

                if (inmueble) {
                    // Reemplaza 'Precio' por el nombre exacto de la propiedad en tu modelo Inmueble (ej. Precio, Valor, Alquiler)
                    var precioDiario = inmueble.Precio || inmueble.PrecioDiario || 0; 
                    var costoTotal = dias * precioDiario;

                    // Ajusta el % según lo que pida tu consigna (ejemplo: 50% = 0.50)
                    var porcentajeReserva = 0.50; 
                    var montoCalculado = costoTotal * porcentajeReserva;

                    // Asignar el valor al campo input Monto (con 2 decimales)
                    $('#Monto').val(montoCalculado.toFixed(2));
                }
            } else {
                $('#Monto').val(''); // Fechas inválidas
            }
        }
    }
</script>