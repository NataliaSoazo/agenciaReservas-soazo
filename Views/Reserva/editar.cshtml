@model agenciaReservas_soazo.Models.Reserva

@{
    ViewData["Title"] = "Reserva";

    int id = Model?.Id ?? 0;
}

<div class="container text-center">
    <h4>Reserva</h4>
</div>

<hr />

<div class="row">
    <div class="col-9 table-wrapper">

        <form asp-action="Guardar" method="post" class="row g-3">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="Anulado" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>


            <!-- CÓDIGO -->
            <div class="form-group col-1">
                <label class="control-label">CÓDIGO</label>
                <input class="form-control" value="@id"readonly />
            </div>


            <!-- FECHA -->
            <div class="form-group col-3">
                <label asp-for="Fecha"class="control-label"></label>
                <input asp-for="Fecha" type="date"class="form-control"readonly />
                <span asp-validation-for="Fecha"class="text-danger"></span>
            </div>
            <div class="form-group col-4">
                <label asp-for="FechaDesde" class="control-label"></label>
                <input asp-for="FechaDesde"type="date"class="form-control" />
                <span asp-validation-for="FechaDesde"class="text-danger"></span>
            </div>
            <div class="form-group col-4">
                <label asp-for="FechaHasta"class="control-label"></label>

                <input asp-for="FechaHasta"type="date"class="form-control" />
                <span asp-validation-for="FechaHasta"
                class="text-danger"></span>
            </div>

            <div class="form-group col-6">
                <label class="control-label">Inmueble</label>

                <input type="text"
                       id="inputBusquedaInmueble"
                       class="form-control"
                       placeholder="Buscar por domicilio o dueño..."
                       autocomplete="off" />

                <input type="hidden"
                       asp-for="IdInmueble"
                       id="IdInmueble" />

                <div id="resultadosInmuebles" class="mt-2"></div>
            </div>
            <div class="form-group col-6">
                <label asp-for="Monto" class="control-label"></label>
            
                <input asp-for="Monto"
                       id="Monto"
                       type="number"
                       step="0.01"
                       class="form-control"
                       placeholder="Se calcula automáticamente"
                       readonly />
            
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
            <!-- INQUILINO -->
            <div class="form-group col-6">
                <label class="control-label">Inquilino</label>
            
                <input type="text"
                       id="inputBusquedaInquilino"
                       class="form-control"
                       placeholder="Buscar por nombre, apellido o DNI..."
                       autocomplete="off" />
            
                <input type="hidden"
                       asp-for="IdInquilino"
                       id="IdInquilino" />
            
                <div id="resultadosInquilinos" class="mt-2"></div>
            </div>
            <div class="form-group col-12">
                <input type="submit"value="Guardar"class="btn btn-success" />
                <a asp-action="Index"class="btn btn-secondary">
                    Cancelar
                </a>
            </div>
         </form>
    </div>
</div>


<script>
    window.inquilinosData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            ((IList<Inquilino>)ViewBag.Inquilinos).Select(x => new
            {
                x.Id,
                x.Nombre,
                x.Apellido,
                x.Dni
            })
        )
    );

    window.inmueblesData = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            ((IList<Inmueble>)ViewBag.Inmuebles).Select(x => new
            {
                x.Id,
                x.Direccion,

                // Precio por día del inmueble
                Precio = x.Precio,

                Duenio = x.Duenio == null ? null : new
                {
                    x.Duenio.Nombre,
                    x.Duenio.Apellido
                }
            })
        )
    );
</script>

<script src="~/js/reservas.js" asp-append-version="true"></script>