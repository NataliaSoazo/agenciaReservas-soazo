@model agenciaReservas_soazo.Models.Pago

@{
    ViewData["Title"] = "Pago de multa";

    var reserva = ViewBag.Reserva as agenciaReservas_soazo.Models.Reserva;
    double totalAPagar = ViewBag.TotalMulta;
    var fechaTerminacion = (DateTime)ViewBag.FechaCulminacion;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Pago de multa por cancelación anticipada</h4>
                </div>

                <div class="card-body">

                    @if (reserva != null)
                    {
                        <div class="alert alert-info">

                            <h5>Datos de la Reserva</h5>

                            <div class="row">
                                <div class="col-md-6">
                                    <strong>ID Reserva:</strong>
                                    @reserva.Id
                                </div>

                                <div class="col-md-6">
                                    <strong>Inquilino:</strong>
                                    @reserva.Arrendatario?.Nombre
                                    @reserva.Arrendatario?.Apellido
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <strong>Inmueble:</strong>
                                    @reserva.DatoInmueble?.Direccion
                                </div>

                                <div class="col-md-6">
                                    <strong>Fecha de inicio:</strong>
                                    @reserva.FechaDesde.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                            <div class="row mt-2">
                                <div class="col-md-6">
                                    <strong>Fecha original de finalización:</strong>
                                    @reserva.FechaHasta.ToString("dd/MM/yyyy")
                                </div>

                                <div class="col-md-6">
                                    <strong>Fecha de terminación anticipada:</strong>
                                    @fechaTerminacion.ToString("dd/MM/yyyy")
                                </div>
                            </div>

                        </div>
                    }

                    <h5>Detalle del cálculo de la multa</h5>

                    <table class="table table-bordered">

                        <tbody>
                            <tr>
                                <th>Días originales del alquiler</th>
                                <td>@ViewBag.DiasOriginales</td>
                            </tr>

                            <tr>
                                <th>Días cumplidos</th>
                                <td>@ViewBag.DiasCumplidos</td>
                            </tr>

                            <tr>
                                <th>Alquiler restante</th>
                                <td>
                                    $@(((double)ViewBag.AlquilerRestante).ToString("N2"))
                                </td>
                            </tr>

                            <tr>
                                <th>Porcentaje de multa</th>
                                <td>@ViewBag.PorcentajeMulta %</td>
                            </tr>

                            <tr class="table-light">
                                <th>IMPORTE TOTAL DE LA MULTA</th>
                                <td class="text-danger fw-bold">
                                    $@totalAPagar.ToString("N2")
                                </td>
                            </tr>
                        </tbody>

                    </table>

                    <hr />

                    <h5>Registrar pago de multa</h5>

                    <form asp-controller="Pago"
                          asp-action="ConcretarCancelacion"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input type="hidden"
                               asp-for="IdReserva"
                               value="@reserva?.Id" />

                        <input type="hidden"
                               asp-for="Anulado"
                               value="false" />

                        <input type="hidden"
                               asp-for="Concepto"
                               value="MULTA POR CANCELACIÓN ANTICIPADA" />

                        <input type="hidden"
                               asp-for="Importe"
                               value="@totalAPagar" />

                        <input type="hidden"
                               name="IdReserva"
                               value="@reserva?.Id" />

                        <input type="hidden"
                               name="FechaTerminacion"
                               value="@fechaTerminacion.ToString("yyyy-MM-dd")" />

                        <div class="mb-3">
                            <label class="form-label">Concepto</label>

                            <input class="form-control"
                                   value="MULTA POR CANCELACIÓN ANTICIPADA"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Importe a pagar</label>

                            <input class="form-control"
                                   value="@totalAPagar.ToString("N2")"
                                   readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Fecha" class="form-label"></label>

                            <input asp-for="Fecha"
                                   class="form-control"
                                   type="date"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />

                            <span asp-validation-for="Fecha"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Modo" class="form-label"></label>

                            <select asp-for="Modo" class="form-select" required>

                                <option value="">-- Seleccione un modo de pago --</option>
                                <option value="EFECTIVO">EFECTIVO</option>
                                <option value="TRANSFERENCIA">TRANSFERENCIA</option>
                                <option value="TARJETA">TARJETA</option>

                            </select>

                            <span asp-validation-for="Modo"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">

                            <a asp-controller="Reserva"
                               asp-action="Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-cash"></i>
                                Registrar pago de multa
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}