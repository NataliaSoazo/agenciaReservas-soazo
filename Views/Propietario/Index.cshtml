@model IEnumerable<Propietario>


@{
    ViewData["Title"] = "Index";
}

<h4> Listado  de Propietarios</h4>

<p>
    <a asp-action="Editar"method = "post">CREAR NUEVO PROPIETARIO</a>
</p>
<form asp-action="BuscarPropietario" method="get">
    <p>
        Buscar propietario: <input type="text" name="buscar" class="form-text" />
        <input type="submit" value="Buscar" class="btn btn-dark" />
    </p>
</form>
<div class= "table-wrapper">
<table class="table" id="table">
    <thead> 
        <tr>
            <th >
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Apellido)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefono)
            </th>
             <th>
               ACCIONES
            </th>
        </tr>
    </thead>
    <tbody id="table">
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Apellido)
                </td>
              
                <td>
                    @Html.DisplayFor(modelItem => item.Telefono)
                </td>
                
               
                <td>
                    <a asp-action="Detalles" asp-route-id=@item.Id title="Ver Detalles"><i class="fa fa-eye " style="font-size:25px;" id="detalles"></i></a>
                    <a asp-action="Editar" asp-route-id=@item.Id title="Editar item"><i class="fa fa-pencil " style="font-size:25px;" id="edi" ></i></a>
                   
                    <a href="#" onclick="eliminar('@item.Id', '@item.Nombre', '@item.Apellido')" title="Eliminar">
                        <i class="fa fa-trash" style="font-size:25px;" id="eli"></i>
                    </a>
                    
                  
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
<div class="table-wrapper">

    <form method="post" asp-action="Eliminar">

        <div class="modal fade"
             id="modal_eliminar_propietario"
             tabindex="-1"
             aria-labelledby="tituloEliminarPropietario"
             aria-hidden="true">

            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title" id="tituloEliminarPropietario">
                            DESEAS ELIMINAR A:
                        </h5>

                        <!-- X -->
                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Cerrar">
                        </button>

                    </div>

                    <div class="modal-body">

                        <input type="hidden"
                               name="id"
                               value=""
                               id="propietario_eliminar_id">

                        <p>
                            <span id="propietario_eliminar_nombre"></span>
                        </p>

                    </div>

                    <div class="modal-footer">

                        <button type="submit"
                                class="btn btn-danger">
                            Eliminar
                        </button>

                        <!-- Salir -->
                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Salir
                        </button>

                    </div>

                </div>
            </div>

        </div>

    </form>

</div>
@section Scripts{
        <script src="~/js/propietario.js"></script>
}