@model IEnumerable<Inmueble>


@{
    ViewData["Title"] = "Index";
}

<h3> Consultas sobre inmuebles</h3>

<div class="row">
    <div class="col-4 border">
        <form asp-action="DisponiblesPorFechas" method="get">
            <div class="form-group col-6">
                <label for="fechaInicio">Fecha Desde:</label>
                <input type="date" name="fechaInicio" class="form-control" required />
            </div>
            <div class="form-group col-6">
                <label for="fechaFin">Fecha Hasta:</label>
                <input type="date" name="fechaFin" class="form-control" required />
            </div>
            <div>
                <input type="submit" value="Disponibles entre fechas " class="btn btn-secondary m-2" />
            </div>
        </form>
    </div>
    <div class="col-4 border">
        <form asp-action="BuscarPropietarios" method="get">
            <p>
                Buscar inmuebles por propietario:
                <input type="text" name="buscar" class="form-text" required/>
                <input type="submit" value="Buscar" class="btn btn-secondary" />
            </p>
        </form>
        <form asp-action="sinReservasXdias" method="get">
                <p>
                    Buscar no reservados en ... dias:
                    <div>
                        <input type="number" name="cantidadDias" class="form-text" required min="1" />
                        <input type="submit" value="Buscar " class="btn btn-secondary" />
                    </div>
                </p>
        </form>
    </div>
    <div class="col-4 border">
        <div>
            
            <div>
                <p>Lista los inmuebles más reservados en el ultimo año</p>
                <form asp-action="MasReservados365" method="get">
                    <div class="form-group">
                        <input type="submit" value="Buscar en rango de un año " class="btn btn-secondary" />
                    </form>
                </div>
            </div>
            <div>
                <p>Lista los inmuebles dispuestos por sus propietarios</p>
                <form asp-action="DispuestosxDueño" method="get">
                    <div class="form-group">
                        <input type="submit" value="Inmuebles disponibles " class="btn btn-secondary" />
                    </form>
                </div>
            </div>
        </div>
    </div>
<h3> Listado de  inmuebles</h3>
<p>
    <a asp-action="Editar" method="post">CREAR NUEVO </a>
</p>
<div class="table-wrapper">
    <table class="table" id="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Id)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Direccion)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Duenio)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Uso)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Disponible)
                </th>
                <th>
                    ACCIONES
                </th>
            </tr>
        </thead>
        <tbody id="table">
            @foreach (var item in Model)
            {
                <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Direccion)
                        </td>
                        <td>
                            @item.Duenio.Apellido, @item.Duenio.Nombre
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Uso)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Disponible)
                        </td>


                        <td>
                            <a asp-action="Detalles" asp-route-id=@item.Id title="Ver Detalles"><i class="fa fa-eye "
                                style="font-size:25px;" id="detalles"></i></a>
                            <a asp-action="Editar" asp-route-id=@item.Id title="Editar item"><i class="fa fa-pencil "
                                style="font-size:25px;" id="edi"></i></a>
                            <a href="#" onclick="eliminar('@item.Id', '@item.Direccion')" title="Eliminar">                                
                            <i class="fa fa-trash" style="font-size:25px;" id="eli"></i>                           </a>

                        </td>
                </tr>
             }
                </tbody>
            </table>

    
        </div>
        <nav aria-label="Paginación">

            <ul class="pagination">

                @if (ViewBag.PaginaActual > 1)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual - 1)">
                            Anterior
                        </a>
                    </li>
                }

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link" asp-action="Index" asp-route-pagina="@i">
                            @i
                        </a>

                    </li>
                }

                @if (ViewBag.PaginaActual < ViewBag.TotalPaginas)
                {
                    <li class="page-item">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(ViewBag.PaginaActual + 1)">
                            Siguiente
                        </a>
                    </li>
                }

            </ul>

        </nav>
        <div class= "container  col-2">
            <button type="button" class="btn btn-secondary"
        onclick="history.back()">
             <i class="bi bi-arrow-left"></i> Volver
        </button>
        </div>
        <form method="post" asp-action="Eliminar">

            <div class="modal fade " id="modal_eliminar_inmueble" tabindex="-1" aria-labelledby="tituloEliminarDomicilio"
                 aria-hidden="true">

                <div class="modal-dialog">
                    <div class="modal-content">

                        <div class="modal-header">
                            <h5 class="modal-title" id="tituloEliminarDomicilio">
                                ¿DESEAS ELIMINAR A:
                            </h5>

                            <!-- X: cierra sin enviar -->
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                            </button>
                        </div>

                        <div class="modal-body">
                            <input type="hidden" name="id" id="Domicilio_eliminar_id" />
                            <span id="Domicilio_eliminar_nombre"></span>?
                            <p>Esta acción no se puede deshacer.</p>
                        </div>

                        <div class="modal-footer">
                            <button type="submit" class="btn btn-danger">
                                Eliminar
                            </button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                Salir
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </form>

        @section Scripts {
            <script src="~/js/inmueble.js"></script>
        }