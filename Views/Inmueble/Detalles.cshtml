@model agenciaReservas_soazo.Models.Inmueble

@{
    ViewData["Title"] = "Detalles";

    var imagenes = ViewBag.Imagenes as IList<agenciaReservas_soazo.Models.ImagenInmueble>;

    // PRIMERA IMAGEN: PRINCIPAL
    var imagenPrincipal = imagenes?.OrderBy(i => i.Id).FirstOrDefault();

    // RESTO DE IMÁGENES: SECUNDARIAS
    var otrasImagenes = imagenes?.OrderBy(i => i.Id).Skip(1).ToList();
}

<div class="container mt-4 mb-5">

    <div class="row g-4 align-items-stretch">

        <div class="col-md-6">
            <div class="card shadow p-4 h-100">
                <h4 class="text-center">Detalles del Inmueble</h4>
                <hr />

                <dl class="row mb-0">
                    <dt class="col-6">@Html.DisplayNameFor(model => model.Id)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Id)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Direccion)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Direccion)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Tipo)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Tipo)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Uso)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Uso)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Cupo)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Cupo)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Precio)</dt>
                    <dd class="col-6">$@Html.DisplayFor(model => model.Precio)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Latitud)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Latitud)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Longitud)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Longitud)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.Disponible)</dt>
                    <dd class="col-6">@Html.DisplayFor(model => model.Disponible)</dd>

                    <dt class="col-6">@Html.DisplayNameFor(model => model.PropietarioId)</dt>
                    <dd class="col-6">(@Model.PropietarioId) @Model.Duenio.Apellido @Model.Duenio.Nombre</dd>
                </dl>
            </div>
        </div>

        <!-- IMAGEN PRINCIPAL -->
        <div class="col-md-6">
            <div class="card shadow p-4 h-100">
                <h4 class="text-center">Imagen destacada</h4>
                <hr />

                @if (imagenPrincipal != null && !string.IsNullOrEmpty(imagenPrincipal.ImgURL))
                {
                    <img src="@imagenPrincipal.ImgURL" class="img-fluid rounded mb-3" style="width:100%; height:300px; object-fit:contain;" alt="Imagen principal del inmueble" />

                }
                else
                {
                    <div class="d-flex justify-content-center align-items-center bg-light rounded mb-3" style="height:300px;">
                        <div class="text-center text-muted">
                            <i class="fas fa-image fa-4x mb-3"></i>
                            <p>No hay imagen principal</p>
                        </div>
                    </div>
                }

                <hr />

                <!-- FORMULARIO SUBIR IMAGEN PRINCIPAL -->
                <form asp-controller="ImagenInmueble" asp-action="AgregarFotoPrincipal" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="InmuebleId" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Seleccionar foto destacada</label>
                        <input type="file" name="archivo" class="form-control" accept="image/*" required />
                    </div>
                    <button type="submit" class="btn btn-secondary w-100"><i class="fas fa-camera"></i> @(imagenPrincipal != null ? "Cambiar imagen destacada" : "Subir imagen destacada")</button>
                </form>
            </div>
        </div>

    </div>

    <!-- IMÁGENES SECUNDARIAS -->
    <div class="card shadow p-4 mt-4">
        <h4 class="text-center">Otras fotos</h4>
        <hr />

        <!-- FORMULARIO SUBIR IMÁGENES SECUNDARIAS -->
        <form asp-controller="ImagenInmueble" asp-action="OtrasImagenes" method="post" enctype="multipart/form-data">
            <input type="hidden" name="InmuebleId" value="@Model.Id" />
            <div class="mb-3">
                <label class="form-label">Selecciona foto</label>
                <input type="file" name="archivos" class="form-control" accept="image/*" multiple required />
                <small class="text-muted">Puedes seleccionar varias imágenes al mismo tiempo.</small>
            </div>
            <button type="submit" class="btn btn-success"><i class="fas fa-images"></i> Subir imágenes secundarias</button>
        </form>

        <hr />

        <!-- MOSTRAR IMÁGENES SECUNDARIAS -->
        <div class="row g-3">
            @if (otrasImagenes != null && otrasImagenes.Count > 0)
            {
                @foreach (var imagen in otrasImagenes)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card shadow-sm h-100">
                            <img src="@imagen.ImgURL" class="card-img-top" style="height:180px; object-fit:cover;" alt="Imagen secundaria del inmueble" />

                            <div class="card-body text-center">
                                <span class="text-muted">Imagen secundaria</span>
                            </div>

                            <!-- FORMULARIO ELIMINAR IMAGEN SECUNDARIA -->
                            <div class="card-footer">
                                <form asp-controller="ImagenInmueble" asp-action="EliminarImagen" method="post" onsubmit="return confirm('¿Eliminar esta imagen?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@imagen.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm w-100"><i class="fas fa-trash"></i> Eliminar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- VOLVER -->
    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Volver al listado</a>
    </div>

</div>