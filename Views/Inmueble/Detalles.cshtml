@model agenciaReservas_soazo.Models.Inmueble

@{
    ViewData["Title"] = "Detalles";
    var imagenes = ViewBag.Imagenes as IList<agenciaReservas_soazo.Models.ImagenInmueble>;
}

<div class="table-wrapper">

    <div class="container justify-content-center col-6" id="table">

        <h4 class="text-center">Detalles del Inmueble</h4>
        <hr />

        <dl class="row">

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Id)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Id)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Direccion)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Direccion)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Tipo)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Tipo)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Uso)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Uso)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Cupo)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Cupo)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Precio)
            </dt>
            <dd class="col-6">
                $@Html.DisplayFor(model => model.Precio)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Latitud)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Latitud)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Longitud)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Longitud)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.Disponible)
            </dt>
            <dd class="col-6">
                @Html.DisplayFor(model => model.Disponible)
            </dd>

            <dt class="col-6">
                @Html.DisplayNameFor(model => model.PropietarioId)
            </dt>
            <dd class="col-6">
                (@Model.PropietarioId)
                @Model.Duenio.Apellido
                @Model.Duenio.Nombre
            </dd>

        </dl>

        <!-- BOTÓN AGREGAR FOTOS -->
        <div class="text-center mt-3">

            <a href="#"
               class="btn btn-primary"
               data-bs-toggle="modal"
               data-bs-target="#modalAgregarImagen">

                <i class="fas fa-camera"></i>
                Agregar fotos

            </a>

        </div>

    </div>


    <!-- ========================= -->
    <!-- IMÁGENES DEL INMUEBLE -->
    <!-- ========================= -->

    @if (imagenes != null && imagenes.Count > 0)
    {
        <div class="container mt-4">

            <h4 class="text-center">
                Fotos del inmueble
            </h4>

            <div class="row justify-content-center">

                @for (int i = 0; i < imagenes.Count; i++)
                {
                    var imagen = imagenes[i];

                    @if (i == 0)
                    {
                        <!-- PRIMERA IMAGEN: PRINCIPAL -->
                        <div class="col-md-8 mb-4 text-center">

                            <div class="card shadow">

                                <div class="card-header">
                                    <strong>Imagen principal</strong>
                                </div>

                                <img src="@imagen.ImgURL"
                                     class="card-img-top"
                                     style="max-height:400px; object-fit:contain;"
                                     alt="Imagen principal del inmueble" />

                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- RESTO DE LAS IMÁGENES -->
                        <div class="col-md-4 mb-3">

                            <div class="card shadow-sm">

                                <img src="@imagen.ImgURL"
                                     class="card-img-top"
                                     style="height:180px; object-fit:cover;"
                                     alt="Imagen del inmueble" />

                            </div>

                        </div>
                    }
                }

            </div>

        </div>
    }


    <!-- VOLVER -->
    <div class="container mt-3">

        <a asp-action="Index">
            Volver al listado
        </a>

    </div>

</div>


<!-- ========================= -->
<!-- MODAL AGREGAR IMAGEN -->
<!-- ========================= -->

<div class="modal fade"
     id="modalAgregarImagen"
     tabindex="-1"
     aria-labelledby="tituloAgregarImagen"
     aria-hidden="true">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="tituloAgregarImagen">
                    Agregar foto del inmueble
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <form asp-controller="ImagenInmueble"
                  asp-action="AgregarImagen"
                  method="post"
                  enctype="multipart/form-data">

                <div class="modal-body">

                    <input type="hidden"
                           name="InmuebleId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label class="form-label">
                            Seleccionar foto
                        </label>

                        <input type="file"
                               name="archivo"
                               class="form-control"
                               accept="image/*"
                               required />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-primary">
                        Subir foto
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>