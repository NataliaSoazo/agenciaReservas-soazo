@model Inmueble
@{
    ViewData["Title"] = "Inmueble";
    int id = Model == null ? 0 : Model.Id;
}

<div class="container">
    <h3 class="mb-3-center">Inmueble</h3>

    <div class="card p-4 shadow-sm">
        <form asp-action="Guardar" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <!-- FILA 1 -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="control-label">CÓDIGO</label>
                    <input name="Id" class="form-control" value="@id" readonly />
                </div>
                <div class="col-md-4">
                    <label asp-for="PropietarioId" class="control-label">PROPIETARIO</label>
                    <select class="form-control" name="PropietarioId" id="selectPropietarios">
                        @foreach (var item in (IList<Propietario>)ViewBag.Propietarios)
                        {
                            @:<option @(item.Id == Model?.PropietarioId ? "selected" : "") value="@item.Id"> @item.Apellido @item.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Direccion" class="control-label"></label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>
            </div>

            <!-- FILA 2 -->
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Tipo" class="control-label"></label>
                    <select class="form-control" name="Tipo" id="selectTipo">
                        @foreach (var item in (IList<TipoInmueble>)ViewBag.TipoInmuebles)
                        {
                            @:<option @(item.Tipo == Model?.Tipo ? "selected" : "") value="@item.Tipo"> @item.Tipo</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Uso" class="control-label"></label>
                    <select class="form-control" name="Uso" id="selectUso">
                        @foreach (var item in (IList<UsoInmueble>)ViewBag.UsoInmuebles)
                        {
                            @:<option @(item.Uso == Model?.Uso ? "selected" : "") value="@item.Uso"> @item.Uso</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Cupo" class="control-label"></label>
                    <input asp-for="Cupo" class="form-control" />
                    <span asp-validation-for="Cupo" class="text-danger"></span>
                </div>
            </div>

            <!-- FILA 3 -->
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label asp-for="Precio" class="control-label"></label>
                    <input asp-for="Precio" class="form-control" />
                    <span asp-validation-for="Precio" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Latitud" class="control-label"></label>
                    <input asp-for="Latitud" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Longitud" class="control-label"></label>
                    <input asp-for="Longitud" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Disponible" class="control-label"></label>
                    <select class="form-control" asp-for="Disponible">
                        <option value="">Selecciona aqui</option>
                        <option value="SI">SI</option>
                        <option value="NO">NO</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Porcentual" class="control-label"></label>
                    <input asp-for="Porcentual" class="form-control" />
                </div>
            </div>

            <div class="row mt-4">
                <div class="col-12">
                    <input type="submit" value="Guardar" class="btn btn-primary px-5" />
                    <a asp-action="Index" class="btn btn-secondary ms-2">Volver al listado</a>
                </div>
            </div>
        </form>
    </div>

    <hr class="my-4" />

    <!-- ABAJO EN 2 COLUMNAS -->
    <div class="row">
        <div class="col-md-6">
            <div class="card p-3">
                <h5 class="text-center">Listado de uso de Inmueble</h5>
                <table class="table table-striped table-sm" id="tableUso">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Uso</th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (IList<UsoInmueble>)ViewBag.UsoInmuebles)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Uso</td>
                                <td>
                                    <a href="#" onclick="editarUso('@item.Id','@item.Uso')" title="Editar"><i class="fa fa-pencil" style="font-size:20px;"></i></a>
                                    <a href="#" onclick="eliminarUso('@item.Id','@item.Uso')" title="Eliminar"><i class="fa fa-trash" style="font-size:20px; color:red;"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card p-3">
                <h5 class="text-center">Listado de tipos de Inmueble</h5>
                <table class="table table-striped table-sm" id="tableTipo">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Tipo</th>
                            <th>ACCIONES</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in (IList<TipoInmueble>)ViewBag.TipoInmuebles)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Tipo</td>
                                <td>
                                    <a href="#" onclick="editarTipo('@item.Id','@item.Tipo')" title="Editar"><i class="fa fa-pencil" style="font-size:20px;"></i></a>
                                    <a href="#" onclick="eliminarTipo('@item.Id','@item.Tipo')" title="Eliminar"><i class="fa fa-trash" style="font-size:20px; color:red;"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/lib/select2/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#selectPropietarios').select2();
            $('#selectTipo').select2();
            $('#selectUso').select2();
        });
    </script>
}